# ==============================================================================================
# pins.env - EVERY version / digest / option pin used by vorbis-native-tools/linux.
# Edit here only. build.sh sources this file and passes the values into container-build.sh,
# and both echo them at the top of every run, so a build log always says exactly what it used.
# ==============================================================================================

# --- Container images -------------------------------------------------------------------------
# The manylinux images exist to fix the glibc baseline. Building on a modern desktop distro
# bakes THAT distro's glibc version into the .so, and glibc symbol versioning is forward-only,
# so the library would then refuse to load on anything older.
#
#   image                                  glibc  runs on
#   manylinux_2_28_x86_64                  2.28   Debian 10+, Ubuntu 20.04+, RHEL 8+
#   manylinux_2_28_aarch64                 2.28   every 64-bit Raspberry Pi OS, Ubuntu 20.04+
#   manylinux_2_39_riscv64                 2.39   Ubuntu 24.04+, Debian 13+
#
# The same three images, at the same dated tag and the same digests, that CodeBrix.Sdl3,
# CodeBrix.VideoPlayback.Dav1d, CodeBrix.Ollama and CodeBrix.Audio pin, so every CodeBrix Linux
# native comes from one base userland. The digest is what the build actually pins.
IMAGE_X64=quay.io/pypa/manylinux_2_28_x86_64:2026.07.19-1
IMAGE_X64_DIGEST=sha256:a61875a2f84cab7df8de222ff12cabc08ff86eb4ad402ac90ba7bdaed9600cca
IMAGE_ARM64=quay.io/pypa/manylinux_2_28_aarch64:2026.07.19-1
IMAGE_ARM64_DIGEST=sha256:162c81dfd3efc710732a571717d3c916a6945ebf279e879ddee3243af96fe46f
IMAGE_RISCV64=quay.io/pypa/manylinux_2_39_riscv64:2026.07.19-1
IMAGE_RISCV64_DIGEST=sha256:04b3acc69a6cebb10ac1252587d202acce6445d91c783d3f92229bb2b2483069

# The derived images this tooling builds ON TOP of those. UNLIKE Sdl3's, they install NOTHING:
# the base images already carry everything this build needs (gcc-toolset 14 / gcc 14, cmake 4.4,
# GNU make, binutils, file). The Containerfile only PROVES that toolchain and records it, so even
# building the derived image needs no network (build.sh builds it with --network none).
DERIVED_IMAGE_PREFIX=codebrix-vorbis-build

# --- Vendored source (in-repo; nothing is fetched at build time) --------------------------------
OGG_DIR=ogg
OGG_VERSION=1.3.6
OGG_TARBALL_SHA256=5c8253428e181840cd20d41f3ca16557a9cc04bad4a3d04cce84808677fa1061
VORBIS_DIR=vorbis
VORBIS_VERSION=1.3.7
VORBIS_TARBALL_SHA256=b33cc4934322bcbf6efcbacf49e3ca01aadbea4114ec9589d1b1e9d20f72954b

# --- The shipped library ----------------------------------------------------------------------
# DllImport("codebrix_vorbis") probes runtimes/<rid>/native/libcodebrix_vorbis.so. The shim's
# CMakeLists sets no VERSION/SOVERSION, so the build produces exactly that one regular file and its
# SONAME is the same unversioned name.
LIB_NAME=libcodebrix_vorbis.so
LIB_SONAME=libcodebrix_vorbis.so
LICENSE_VORBIS_NAME=LICENSE-Vorbis.txt
LICENSE_OGG_NAME=LICENSE-Ogg.txt

# --- CMake options ------------------------------------------------------------------------------
#   -G "Unix Makefiles"            the base images carry GNU make, not ninja; nothing is installed
#   CMAKE_BUILD_TYPE=Release       -O3 -DNDEBUG
# CMAKE_C_FLAGS (set by container-build.sh) adds -g (for the unstripped twin) and
# -ffile-prefix-map so the scratch paths of the build do not end up in the binary.
CBV_CMAKE_OPTIONS="-DCMAKE_BUILD_TYPE=Release"

# --- Verification gate ---------------------------------------------------------------------------
GLIBC_MAX_X64=2.28
GLIBC_MAX_ARM64=2.28
GLIBC_MAX_RISCV64=2.39

# Shared libraries the .so is allowed to depend on. Anything else is a gate failure.
ALLOWED_DEPS="libc.so.6 libm.so.6 ld-linux-x86-64.so.2 ld-linux-aarch64.so.1 ld-linux-riscv64-lp64d.so.1"

# The EXACT export set (codebrix_vorbis.h). The gate fails on a missing one AND on any extra
# exported function - every libogg / libvorbis symbol must stay hidden.
REQUIRED_SYMBOLS="codebrix_vorbis_api_version codebrix_vorbis_library_version codebrix_vorbis_encoder_create codebrix_vorbis_encoder_add_comment codebrix_vorbis_encoder_write_headers codebrix_vorbis_encoder_write_float codebrix_vorbis_encoder_finish codebrix_vorbis_encoder_pending_output codebrix_vorbis_encoder_read_output codebrix_vorbis_encoder_granule_position codebrix_vorbis_encoder_destroy"
